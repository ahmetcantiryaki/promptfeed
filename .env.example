# ─── Supabase (required) ──────────────────────────────────────────────────
# Public client — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER commit, never expose in client bundles, never log.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site URL (optional but recommended in production) ────────────────────
# Used for canonical metadata, sitemap, and password-reset redirect allowlist.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ─── Rate limiting (optional — recommended for production) ────────────────
# When unset, rate limiting is bypassed (dev). Set both to enable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
